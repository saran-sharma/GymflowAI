{
  "name": "gymflow-ai",
  "private": true,
  "version": "1.0.0",
  "description": "GymFlow AI — trainer accountability for SLAM Fitness Studio",
  "scripts": {
    "api": "cd backend && ../.venv/bin/uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "mobile": "npm --prefix apps/mobile run start:tunnel",
    "mobile:lan": "npm --prefix apps/mobile run start",
    "web-demo": "npm --prefix apps/web-demo run dev",
    "migrate": "cd backend && ../.venv/bin/alembic upgrade head",
    "seed": "cd backend && ../.venv/bin/python -m app.seed",
    "seed:reset": "cd backend && ../.venv/bin/python -m app.seed --reset",
    "test:backend": "cd backend && ../.venv/bin/python -m pytest ../tests/backend",
    "test:mobile": "npm --prefix apps/mobile run test:ci",
    "lint:backend": "cd backend && ../.venv/bin/ruff check app ../tests && ../.venv/bin/ruff format --check app ../tests",
    "typecheck:mobile": "npm --prefix apps/mobile run typecheck",
    "verify": "npm run lint:backend && npm run test:backend && npm run typecheck:mobile && npm run test:mobile",
    "build:android": "npm --prefix apps/mobile run build:android"
  },
  "engines": {
    "node": ">=20"
  }
}
