{
  "name": "gymflow-ai",
  "private": true,
  "version": "1.0.0",
  "description": "GymFlow AI — trainer accountability for SLAM Fitness Studio",
  "scripts": {
    "dev": "node scripts/dev-runner.mjs",
    "dev:backend": "node scripts/dev-runner.mjs --backend-only",
    "dev:mobile": "node scripts/dev-runner.mjs --mobile-only",
    "dev:status": "node scripts/dev-status.mjs",
    "dev:stop": "node scripts/dev-stop.mjs",
    "dev:clean": "node scripts/dev-runner.mjs --clean",
    "api": "node scripts/run-python.mjs -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "mobile": "npm --prefix apps/mobile run start:tunnel",
    "mobile:lan": "npm --prefix apps/mobile run start",
    "web-demo": "npm --prefix apps/web-demo run dev",
    "migrate": "node scripts/run-python.mjs alembic upgrade head",
    "seed": "node scripts/run-python.mjs -m app.seed",
    "seed:reset": "node scripts/run-python.mjs -m app.seed --reset",
    "test:backend": "node scripts/run-python.mjs -m pytest ../tests/backend",
    "test:mobile": "npm --prefix apps/mobile run test:ci",
    "lint:backend": "node scripts/run-python.mjs ruff check app ../tests && node scripts/run-python.mjs ruff format --check app ../tests",
    "typecheck:mobile": "npm --prefix apps/mobile run typecheck",
    "verify": "npm run lint:backend && npm run test:backend && npm run typecheck:mobile && npm run test:mobile",
    "build:android": "npm --prefix apps/mobile run build:android"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "shadcn": "^4.18.0"
  }
}
