# Where the GymFlow API lives. EXPO_PUBLIC_ variables are inlined into the
# JS bundle at build time — never put a secret here.
#
# Android emulator reaching a backend on the host machine:
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
# iOS simulator / web:      http://localhost:8000
# Physical device on wifi:  http://<your-lan-ip>:8000
# Production:               https://api.gymflow.example

# Push notifications are off in V1. Turning this on only enables the
# registration prompt; the transport still has to be wired up.
EXPO_PUBLIC_PUSH_ENABLED=false
