{
  "name": "GymFlow AI",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // 8082 is where scripts/dev-runner.mjs puts Metro. Declaring it here is what
  // makes the forward exist; the runner's `gh codespace ports visibility` call
  // is a backstop for a container where this file has not been re-read, not the
  // mechanism — `gh` is not always authenticated inside the container, and when
  // it is not the port stays private and the phone gets a GitHub login page.
  "forwardPorts": [8000, 8082],

  "portsAttributes": {
    "8000": {
      "label": "GymFlow API",
      "onAutoForward": "notify",
      // A phone is outside the Codespace, so it can only reach the API if this
      // port is public. Codespaces defaults forwarded ports to private, which
      // would make every request fail with an auth redirect.
      "visibility": "public"
    },
    "8082": {
      "label": "Metro bundler",
      "onAutoForward": "silent",
      "visibility": "public"
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postAttachCommand": "bash .devcontainer/welcome.sh",

  "remoteUser": "vscode",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "expo.vscode-expo-tools"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "editor.formatOnSave": false,
        "files.exclude": {
          "**/__pycache__": true,
          "**/.pytest_cache": true,
          "**/.ruff_cache": true
        }
      }
    }
  }
}
