# GymFlow API configuration.
# Copy to backend/.env and fill in. Never commit the real .env.

ENVIRONMENT=development
DEBUG=true

# ---------------------------------------------------------------- database
DATABASE_URL=postgresql+psycopg://gymflow:gymflow@localhost:5432/gymflow

# ---------------------------------------------------------------- security
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in production while this is the development value.
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
BCRYPT_ROUNDS=12

# Check-in QR rotation. Shorter is safer; 60s is the default.
QR_WINDOW_SECONDS=60

# ------------------------------------------------------------- rate limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_CHECKIN=20/minute
# Comma-separated egress IP(s) of the reverse proxy / load balancer. Only then
# is X-Forwarded-For trusted for rate-limit identity. Empty = ignore the header
# and use the socket peer (correct for Codespaces / a direct connection).
RATE_LIMIT_TRUSTED_PROXIES=

# ------------------------------------------------------------------ client
# Comma-separated. Must be explicit origins in production, never "*".
CORS_ORIGINS=*

# ------------------------------------------------------------ integrations
# Every one of these is off in V1. The product is required to work that way.
YOACTIV_ENABLED=false
INBODY_ENABLED=false
ACCESS_CONTROL_ENABLED=false
WHATSAPP_ENABLED=false
INTELLIGENCE_ENABLED=false
PUSH_ENABLED=false

# --------------------------------------------------------- Yoactiv connector
# Server-side only — never sent to the mobile app. Required when
# YOACTIV_ENABLED=true: an https:// base URL (the backdata.asmx root), the
# per-tenant API_Key, and the GymFlow branch id this tenant maps to. A live
# probe (2026-08-30) found the Data API host behind IIS HTTP Basic auth in
# front of the API_Key check, so a Basic user/password is usually needed too
# — leave both blank for a host without that gate. See docs/INTEGRATIONS.md.
YOACTIV_BASE_URL=
YOACTIV_API_KEY=
YOACTIV_BASIC_AUTH_USER=
YOACTIV_BASIC_AUTH_PASSWORD=
YOACTIV_DEFAULT_BRANCH_ID=
YOACTIV_SYNC_WINDOW_DAYS=7
YOACTIV_SYNC_OVERLAP_DAYS=3
YOACTIV_RECONCILE_DAYS=90
YOACTIV_RATE_LIMIT_PER_MIN=60
YOACTIV_REQUEST_TIMEOUT_SECONDS=30

# Fingerprint / X2008 (ADMS). Required only once ACCESS_CONTROL_ENABLED=true —
# see the "Access control" section of docs/INTEGRATIONS.md before setting
# either of these for real.
# FINGERPRINT_COMM_KEY is the terminal's own Communication Key (a secret set
# on the physical device itself); never change what's configured on the unit
# from here.
FINGERPRINT_COMM_KEY=
# FINGERPRINT_ADMS_SHARED_SECRET is a secret GymFlow generates, required in
# the push URL the device is configured to POST to.
FINGERPRINT_ADMS_SHARED_SECRET=
# Development/debug only — refused at boot in production/staging. Set to true
# only for the one real-device capture session at the gym, then unset it.
# Logs method/path (secret redacted)/allow-listed headers/content-type/raw
# ATTLOG body/parsed fields/device identity at DEBUG level to
# `gymflow.hardware.fingerprint.debug`. Never logs the shared secret or a
# fingerprint template.
FINGERPRINT_ADMS_DEBUG_CAPTURE=false
# Fallback-only, for testing whether the physical terminal can reach GymFlow
# at all when its IP-address ADMS mode carries no path (and therefore no
# secret). Refused at boot in production/staging. Authenticates by source IP
# + device serial instead of a secret — a narrower mechanism, not a weaker
# version of the real one. Never enable outside a real-device debugging
# session; delete these three values again immediately after.
FINGERPRINT_ADMS_DEV_IP_MODE=false
FINGERPRINT_ADMS_DEV_IP_MODE_ALLOWED_IP=
FINGERPRINT_ADMS_DEV_IP_MODE_ALLOWED_SERIAL=

# InBody automatic ingestion. Required once a gym PC is running the production
# agent (app/scripts/inbody_agent.py — deploy/windows/inbody-agent/) or the
# validation tool (app/scripts/inbody_watch_agent.py) against a real
# LookinBody120 export folder — see app/api/v1/inbody.py. Off by default; the
# manual Excel importer (app/scripts/import_inbody.py) works regardless.
INBODY_INGEST_ENABLED=false
INBODY_INGEST_SHARED_SECRET=
# Seconds since the gym-PC agent's last heartbeat before GET
# /api/v1/inbody/agent/status reports that branch's agent as offline.
INBODY_AGENT_OFFLINE_AFTER_SECONDS=900

# ---------------------------------------------- feedback & progress media
# Version string a member acknowledges when submitting a trainer review.
FEEDBACK_POLICY_VERSION=2026-08-30
# Shown wherever a testimonial can be reported, so there is always a human to
# reach.
SUPPORT_CONTACT=support@slam.fitness
# Where private progress-photo bytes are written. Dev default is ./var; set an
# absolute path on a private (ideally encrypted) volume in production — the
# API refuses a relative path there. Never a statically served directory.
PROGRESS_PHOTO_DIR=var/progress_photos
PROGRESS_PHOTO_MAX_BYTES=10485760
PROGRESS_PHOTO_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/heic
PROGRESS_PHOTO_URL_TTL_SECONDS=600

# -------------------------------------------------------------------- demo
# Must be false in production.
SEED_DEMO_DATA=true
